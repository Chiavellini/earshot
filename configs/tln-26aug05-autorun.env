# Per-event autorun parameters — TLN (KXEARNINGSMENTIONTLN-26AUG05). Staged by scripts/slate-stage.sh 2026-08-05.
# Sourced by scripts/event-autorun.sh via EARSHOT_EVENT_ENV (systemd timer on the
# box / launchd plist on the laptop). ALL HHMM TIMES ARE BOX-LOCAL = UTC (us-east).
# TO_NUMBER/PASSCODE are TBD ON PURPOSE: event-autorun.sh FAIL-STOPS on TBD, so
# this env cannot place a call until the number hunt lands real digits here.
# NO PHONE LANE (dial-ins admission="no-entry"): CONFIG_PATH points at the WEBCAST
# lane; TO_NUMBER stays TBD so the phone autorun path can never fire this env.
EVENT_NAME="TLN"
EVENT_TICKER="KXEARNINGSMENTIONTLN-26AUG05"          # informational
CONFIG_PATH="configs/webcast-tln-26aug05-arm-wc.toml"
WEBCAST_CONFIG_PATH="configs/webcast-tln-26aug05-arm-wc.toml"   # informational
# Digits stay OUT of git (docs/DIAL-INS.md + the GRAB precedent): read at
# source-time from the gitignored store. preflight `source`s this file, so a
# command substitution satisfies the dial-in gate without committing a PIN.
TO_NUMBER="$(sed -n 's/^TLN=\([^,]*\),.*/\1/p' "$HOME/Code/ear/state/hunt/numbers.env" | head -1)"
PASSCODE="$(sed -n 's/^TLN=[^,]*,\(.*\)/\1/p' "$HOME/Code/ear/state/hunt/numbers.env" | head -1)"
LABEL="com.earshot.tln-26aug05-autorun"
EVENT_DATE="2026-08-05"
END_HHMM_LIVE=2300             # call + 150 min UTC
COMPLETE_EARLIEST_HHMM=2115     # call + 45 min UTC
ACCOUNT_ENV="$HOME/.earshot/ms.env"
BIND_PORT=8093
FIRE_HHMM=2015                # timer fire = call − 25 min, zero-padded HHMM UTC
                                    # (matches install-event-timer.sh --fire-hhmm;
                                    #  preflight-nightly.sh timer check reads it)
TICKERS="AFFO AMAZ ANTH BEHI BITC FOSS HEAD SHAP SMR SOLA TAIL TARI"
