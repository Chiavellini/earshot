<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.earshot.preflight-nightly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <!-- The UTC date is intentional. At 23:30 CDMX the UTC day has already
         rolled to the US-morning event date; if the laptop wakes late the
         same expression still catches up today's events instead of preparing
         tomorrow and silently skipping the current slate. -->
    <string>cd /Users/bernardodelrio/Code/ear &amp;&amp; exec scripts/opsctl.sh prepare-day --date "$(date -u +%F)"</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/bernardodelrio/Code/ear</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/bernardodelrio/.cargo/bin</string>
    <!-- schedule-nightly fails closed when the local execution identity is
         absent. launchd does not inherit the interactive shell exports, so
         the unattended full-chain job must carry both stable host IDs. -->
    <key>EARSHOT_LOCAL_EXECUTION_HOST</key><string>bernardos-macbook-air-5</string>
    <key>EARSHOT_BOX_EXECUTION_HOST</key><string>earshot-useast1</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>23</integer><key>Minute</key><integer>30</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/bernardodelrio/Library/Logs/earshot/event-prep-nightly.log</string>
  <key>StandardErrorPath</key><string>/Users/bernardodelrio/Library/Logs/earshot/event-prep-nightly.log</string>
</dict>
</plist>
