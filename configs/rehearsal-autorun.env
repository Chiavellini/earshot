# Per-event autorun parameters — DRESS REHEARSAL (sourced by
# scripts/event-autorun.sh via EARSHOT_EVENT_ENV; see docs/RUNBOOK.md).
# Always used with EARSHOT_AUTORUN_TEST=1: dry-run flags, TEST window,
# date guard bypassed, and the dial goes to the TTS loopback number only
# (EARSHOT_AUTORUN_TEST_DIAL=1 + EARSHOT_AUTORUN_TEST_TO in the plist).
EVENT_NAME="REHEARSAL"
CONFIG_PATH="configs/rehearsal-nflx.toml"
TO_NUMBER="+17627212978"      # TTS loopback — TEST_TO overrides anyway; never a real bridge
PASSCODE="#"                  # unused by the TTS number
LABEL="com.earshot.rehearsal"
EVENT_DATE="1970-01-01"       # TEST mode bypasses the date guard
END_HHMM_LIVE=0               # unused in TEST (window is now+8min)
COMPLETE_EARLIEST_HHMM=0      # unused in TEST
ACCOUNT_ENV="$HOME/.earshot/ms.env"
TICKERS=""                    # TEST mode skips the strike-close fetch
