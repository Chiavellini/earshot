# BOX-WEBCAST DRILL event env — the §8 rehearsal of docs/work/BOX-WEBCAST.md.
# NOT an earnings call, NOT an issuer; see configs/webcast-boxdrill-26aug14-wc.toml.
#
# What actually consumes this file:
#   * eventctl.py init pins it into the RunPlan (event_env_path + sha256).
#   * install-event-timer.sh:152-176 reads ACCOUNT_ENV out of it ON THE BOX and
#     writes Environment=EARSHOT_ACCOUNT_ENV into the systemd unit; the target
#     must be an absolute regular non-symlink file on the executing host.
# There is NO phone lane here: TO_NUMBER stays TBD so event-autorun.sh
# fail-stops if anything ever points the phone path at this env.
EVENT_NAME="BOXDRILL"
EVENT_TICKER="BOXDRILL-26AUG14"                       # informational; not a Kalshi ticker
CONFIG_PATH="configs/webcast-boxdrill-26aug14-wc.toml"
WEBCAST_CONFIG_PATH="configs/webcast-boxdrill-26aug14-wc.toml"   # informational
TO_NUMBER="TBD"
PASSCODE="TBD"
LABEL="com.earshot.boxdrill-26aug14-autorun"
EVENT_DATE="2026-08-14"
END_HHMM_LIVE=2100              # start + 150 min UTC
COMPLETE_EARLIEST_HHMM=1915     # start + 45 min UTC
ACCOUNT_ENV="$HOME/.earshot/ms.env"
FIRE_HHMM=1715                  # webcast T-75 = 18:30Z − 75 min, zero-padded HHMM UTC
TICKERS="SCRE CHIN"
