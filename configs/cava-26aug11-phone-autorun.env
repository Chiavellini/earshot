# Per-event autorun parameters — CAVA (KXEARNINGSMENTIONCAVA-26AUG11). PHONE LANE.
# Written by scripts/phone-lane-derive.py on 2026-08-11. Sourced by
# scripts/event-autorun.sh via EARSHOT_EVENT_ENV (systemd user timer on the box,
# installed by scripts/box-event-install.sh). ALL HHMM TIMES ARE BOX-LOCAL = UTC.
#
# THIS FILE IS TRACKED IN GIT. Digits are read at source-time from the gitignored
# store, so preflight's dial-in gate can `source` this file and be satisfied
# without a PIN ever entering a commit.
#
# The store path is resolved, not hardcoded: the laptop repo is $HOME/Code/ear
# and the BOX repo is $HOME/ear, and a hardcoded laptop path silently yields an
# empty TO_NUMBER on the box (which event-autorun then reports as "event env
# incomplete" minutes before the call).
EVENT_NAME="CAVA"
EVENT_TICKER="KXEARNINGSMENTIONCAVA-26AUG11"          # informational
CONFIG_PATH="configs/cava-26aug11-phone-arm.toml"
EARSHOT_NUMBERS="${EARSHOT_NUMBERS:-$(for d in "${EARSHOT_REPO:-}" "$HOME/ear" "$HOME/Code/ear"; do [ -f "$d/state/hunt/numbers.env" ] && echo "$d/state/hunt/numbers.env" && break; done)}"
_LINE="$(sed -n 's/^CAVA=//p' "$EARSHOT_NUMBERS" 2>/dev/null | head -1)"
TO_NUMBER="${_LINE%%,*}"
# THREE states, not two. Empty is NOT a safe default for an unresolved lookup
# (preflight's dial-in gate only FAILs on a literal TBD, so a blank would sail
# through as "resolved" with no number) — but empty IS the correct answer for a
# venue with no keyable credential, and conflating them broke the operator path:
#   "CAVA=+1...,1234#"  -> DTMF path, passcode 1234#
#   "CAVA=+1..."        -> NO keyable credential. An operator-screened bridge
#                           takes a reference SPOKEN to a screener, not digits.
#                           Coercing this to TBD made event-autorun refuse to
#                           launch the very venues the operator handler exists
#                           for (HIMS 26AUG10).
#   <line absent>        -> TBD. The hunt never resolved this venue; fail loud.
case "$_LINE" in
  *,*) PASSCODE="${_LINE#*,}" ;;
  ?*)  PASSCODE="" ;;
  *)   PASSCODE="TBD" ;;
esac
TO_NUMBER="${TO_NUMBER:-TBD}"
unset _LINE
LABEL="com.earshot.cava-26aug11-phone"
EVENT_DATE="2026-08-11"
END_HHMM_LIVE=2330             # call + 150 min UTC
COMPLETE_EARLIEST_HHMM=2145     # call + 45 min UTC
ACCOUNT_ENV="/Users/bernardodelrio/.earshot/ms.env"
BIND_PORT=8080
FIRE_HHMM=2035                # timer fire = call - 25 min, zero-padded HHMM UTC
# Tunnel-free production ingress: launch-event.sh takes this verbatim and skips
# ngrok entirely (Q-NGROK/Q-TLS: p99 226 ms -> 20 ms, 61 stalls -> 0).
EARSHOT_STREAM_URL="wss://media.3-212-174-94.sslip.io/e/8080"
# The bridge ANSWERS while unprovisioned and then hangs up, so a too-early dial
# looks SUCCESSFUL to Twilio and dies (TLN 26AUG05: "the conference is not yet
# available", hung up at 13.1 s). Extra attempts plus the source's
# max_reconnects are what carry across the provisioning moment; the wider
# confirm window stops a legitimate redial being called a deaf call.
DIAL_ATTEMPTS=5
STREAM_CONFIRM_SECS=150
TICKERS="ACCE AI AUTO AUV CATE CAVA CYCL DINI EXPA HYPH PITA SALM SAME SHRI SPIC SWEE TARI"
