# Per-event autorun parameters — GE Vernova (GEV) Q2 2026, WEDNESDAY 2026-07-22.
# Sourced by scripts/event-autorun.sh via EARSHOT_EVENT_ENV (launchd plist).
# Call: 7:30 AM ET = 5:30 AM CDMX local (pinned 2026-07-17 from the issuer PR:
# gevernova.com "webcast at 7:30 AM ET"). Fire 05:05, wake 05:00 (pmset).
# TO_NUMBER/PASSCODE: TBD — bridge confirmed (operator "press 11 on your
# telephone", configs/dial-ins.toml [GEV]) but unpublished; Track A hunt:
# IR ask investors@gevernova.com / +1 617 674 7568 (Michael Lapides, VP IR).
# Preflight FAIL-STOPs while TBD.
EVENT_NAME="GEV"
CONFIG_PATH="configs/twilio-live-gev.toml"
TO_NUMBER="TBD"
PASSCODE="TBD"
LABEL="com.earshot.gev-autorun"
EVENT_DATE="2026-07-22"
END_HHMM_LIVE=640             # 06:40 local = call end (~6:30) + margin
COMPLETE_EARLIEST_HHMM=610    # 06:10 local = call + 40 min
ACCOUNT_ENV="$HOME/.earshot/ms.env"
TICKERS="ADMI BLAD CHIN DATA ELEC INFL IRAN NUCL OIL ROBO TARI VIET"
