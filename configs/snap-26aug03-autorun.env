# Per-event autorun parameters — SNAP (KXEARNINGSMENTIONSNAP-26AUG03). Staged by scripts/slate-stage.sh 2026-08-03.
# Sourced by scripts/event-autorun.sh via EARSHOT_EVENT_ENV (systemd timer on the
# box / launchd plist on the laptop). ALL HHMM TIMES ARE BOX-LOCAL = UTC (us-east).
# TO_NUMBER/PASSCODE are TBD ON PURPOSE: event-autorun.sh FAIL-STOPS on TBD, so
# this env cannot place a call until the number hunt lands real digits here.
# NO PHONE LANE (dial-ins admission="untested"): CONFIG_PATH points at the WEBCAST
# lane; TO_NUMBER stays TBD so the phone autorun path can never fire this env.
EVENT_NAME="SNAP"
EVENT_TICKER="KXEARNINGSMENTIONSNAP-26AUG03"          # informational
CONFIG_PATH="configs/webcast-snap-26aug03-arm-wc.toml"
WEBCAST_CONFIG_PATH="configs/webcast-snap-26aug03-arm-wc.toml"   # informational
TO_NUMBER="TBD"             # number hunt / dial-ins number_src
PASSCODE="TBD"
LABEL="com.earshot.snap-26aug03-autorun"
EVENT_DATE="2026-08-03"
END_HHMM_LIVE=2330             # call + 150 min UTC
COMPLETE_EARLIEST_HHMM=2145     # call + 45 min UTC
ACCOUNT_ENV="$HOME/.earshot/ms.env"
BIND_PORT=8085
FIRE_HHMM=2035                # timer fire = call − 25 min, zero-padded HHMM UTC
                                    # (matches install-event-timer.sh --fire-hhmm;
                                    #  preflight-nightly.sh timer check reads it)
# PLAT dropped 2026-08-03: variant study found no recoverable phonetic form, so
# it was deleted from the arm config as ARMED-NO-KEYWORD. Kept out of TICKERS so
# the allowlist matches the armed keyword set exactly (allowlist-diff.sh).
TICKERS="CHIN FAMI GAME GLAS LIVE MEMO PERP REST RETE SPEC STOR TARI UK XBOX"
