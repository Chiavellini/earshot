# Per-event autorun parameters — Domino's (DPZ) Q2 2026, Monday 2026-07-20.
# Sourced by scripts/event-autorun.sh via EARSHOT_EVENT_ENV (launchd plist).
# Call: 8:30 AM ET = 6:30 AM CDMX local. Fire 06:05, wake 06:00 (pmset).
# TO_NUMBER/PASSCODE: TBD — no public dial-in this quarter; hunt per RUNBOOK
# (IR ask + legacy operator numbers + call-morning player check). The 07-19
# preflight must FAIL-STOP if these are still TBD (go/no-go gate).
EVENT_NAME="DPZ"
CONFIG_PATH="configs/twilio-live-dpz.toml"
TO_NUMBER="TBD"               # participant bridge — obtain via Track A
PASSCODE="TBD"                # operator-assisted line may need none ("ask for the call")
LABEL="com.earshot.dpz-autorun"
EVENT_DATE="2026-07-20"
END_HHMM_LIVE=740             # 07:40 local = call end (~7:30) + margin, MS arithmetic
COMPLETE_EARLIEST_HHMM=710    # 07:10 local = call + 40 min
ACCOUNT_ENV="$HOME/.earshot/ms.env"
TICKERS="AI BEST CLOS CRAV DOMO EMER INFL INSU JOE PARM SAME SOCC TAIL TARI"
