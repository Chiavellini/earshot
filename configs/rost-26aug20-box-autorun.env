# BOX twin of rost-26aug20-autorun.env — written by scripts/webcast-box-twin.py; port 8103 = src+10 (first free)
# Per-event autorun parameters — ROST (KXEARNINGSMENTIONROST-26AUG20). Staged by scripts/slate-stage.sh 2026-08-20.
# Sourced by scripts/event-autorun.sh via EARSHOT_EVENT_ENV (systemd timer on the
# box / launchd plist on the laptop). ALL HHMM TIMES ARE BOX-LOCAL = UTC (us-east).
# TO_NUMBER/PASSCODE are TBD ON PURPOSE: event-autorun.sh FAIL-STOPS on TBD, so
# this env cannot place a call until the number hunt lands real digits here.
# NO PHONE LANE (dial-ins admission="no-entry"): CONFIG_PATH points at the WEBCAST
# lane; TO_NUMBER stays TBD so the phone autorun path can never fire this env.
EVENT_NAME="ROST_BOX"
EVENT_TICKER="KXEARNINGSMENTIONROST-26AUG20"          # informational
CONFIG_PATH="configs/webcast-rost-26aug20-box-arm-wc.toml"
WEBCAST_CONFIG_PATH="configs/webcast-rost-26aug20-box-arm-wc.toml"   # informational
TO_NUMBER="TBD"             # number hunt / dial-ins number_src
PASSCODE="TBD"
LABEL="com.earshot.rost-26aug20-box"
EVENT_DATE="2026-08-20"
END_HHMM_LIVE=2245             # call + 150 min UTC
COMPLETE_EARLIEST_HHMM=2100     # call + 45 min UTC
EARSHOT_ACCOUNT_PROFILE="$HOME/.earshot/ms.env"
ACCOUNT_ENV="$HOME/.earshot/ms.env"
BIND_PORT=8103
FIRE_HHMM=1950                # timer fire = call − 25 min, zero-padded HHMM UTC
                                    # (matches install-event-timer.sh --fire-hhmm;
                                    #  preflight-nightly.sh timer check reads it)
TICKERS="BANK BEAU CALI CLOS DRES FLYW HOME KORE NEWY NORT OFFP PACK SELF TEXA"
