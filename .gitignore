/target
report.json
*.wav
# ASR models — fetched by scripts/fetch-models.sh, never committed
models/
# corpus audio (manifests/ IS committed) + alignment venv
corpus/raw/
corpus/telephony/
# call-structure spike: raw transcripts stay local; corpus/structure/ IS committed
corpus/transcripts/
# Bridge-probe ASR transcripts: an operator/IVR reads the dial-in aloud, so these
# carry live digits (CVNA and MSFT both do). Same rule as corpus/transcripts/.
# The .json verdicts and .jsonl frame telemetry alongside them ARE committed —
# they hold held_ms and capture_ns only, never speech.
corpus/bridge-probes/*.txt
# generated adversarial (fast/quiet) corpora — reproducible via scripts/corpus-degrade.sh
corpus-t*/
corpus-quiet/
.venv-corpus/
# secrets — Kalshi keys live in env vars or files outside the repo, never here
*.pem
*.key
.env
.env.*
state/
vendor/
# Python bytecode. Was `scripts/__pycache__/` — path-specific, so every other
# lane (pm-expansion-exploration/, sweep-lane-exploration/) leaked .pyc into the
# tree and five were committed. Global from 2026-08-07.
__pycache__/
*.pyc
slate/latest-timed.json
# Per-run lifecycle ledger and derived date index — generated operational state
# like state/, never source.
var/runs/
# Derived date-level audit indexes (rebuildable from immutable run evidence).
var/audits/
# Archived run evidence pulled aside from var/runs/ — same class of operational
# state, kept on disk only.
var/runs-archive/
# Private staging + lock for scripts/run-host-boundary.py and the box installers'
# dispatch trees. Same class as the three above, and deploy-box.sh:56 has always
# excluded it; only .gitignore was never updated, so `.boundary.lock` showed up
# as untracked after every host-boundary reconcile.
var/host-boundary-staging/
